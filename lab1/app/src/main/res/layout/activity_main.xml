<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">





    <ImageView
        android:id="@+id/appLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="App logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp" />





    <TextView
        android:id="@+id/countOutput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="28sp"
        android:textColor="#222222"
        app:layout_constraintTop_toBottomOf="@id/appLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />




    <LinearLayout
        android:id="@+id/firstButtonRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/countOutput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp">



        <Button
            android:id="@+id/subtractionButton"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:text="-"
            android:layout_weight="1"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#259000"

            />


        <Space
            android:layout_width="80dp"
            android:layout_height="4dp" />


        <Button
            android:id="@+id/addButton"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:text="+"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#259000"
            />



    </LinearLayout>



    <LinearLayout
        android:id="@+id/secondButtonRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/firstButtonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp">


        <Button
            android:id="@+id/resetButton"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:backgroundTint="#FF0000"
            android:text="RESET"
            android:textColor="#FFFFFF"

            />

        <Space
            android:layout_width="80dp"
            android:layout_height="4dp" />


        <Button
            android:id="@+id/stepButton"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:text="STEP"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00FF00"
            />



    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>